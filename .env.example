# ==========================================
# GeoStudy Area Analyzer — Environment Config
# ==========================================

# PostgreSQL / Neon Serverless Database Connection String
DATABASE_URL=postgresql://user:password@ep-example-pooler.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require

# Authentication & Session Security
JWT_SECRET=generate-a-secure-random-32-byte-hex-string-for-jwt-signing
SESSION_SECRET=generate-a-secure-random-32-byte-hex-string-for-session-encryption

# Google Earth Engine (GEE) Service Account Credentials (Optional for local live GEE exports)
# Either provide GEE_SERVICE_ACCOUNT and GEE_PRIVATE_KEY directly or place gee-credentials.json
GEE_SERVICE_ACCOUNT=your-service-account@your-project.iam.gserviceaccount.com
GEE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional Geocoding APIs (Fallback; OSM Nominatim & Copernicus DEM work out-of-the-box without keys)
# GOOGLE_MAPS_API_KEY=your_google_maps_api_key
# MAPBOX_ACCESS_TOKEN=your_mapbox_access_token
